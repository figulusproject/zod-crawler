{
  "name": "@zod-crawler/cli",
  "version": "1.1.0",
  "description": "Fetches a set of JSON API responses and generates a Zod v4 schema that validates all of them.",
  "type": "module",
  "bin": {
    "zod-crawler": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "dependencies": {
    "@zod-crawler/core": "^1.1.0",
    "@zod-crawler/pipeline": "^1.1.0",
    "@zod-crawler/pipeline-node": "^1.1.0",
    "prettier": "^3.8.3",
    "zod": "^4.4.3",
    "zod-commands": "^1.1.3",
    "zod-transformers": "^1.0.0"
  },
  "peerDependencies": {
    "bullmq": "^6.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/figulusproject/zod-crawler",
    "directory": "apps/cli"
  },
  "author": "The Figulus Project",
  "license": "MIT"
}
