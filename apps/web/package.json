{
  "name": "@zod-crawler/web",
  "version": "1.0.0",
  "description": "Web UI for zod-crawler",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EXPRESS_DEV_PORT=3001 concurrently -n server,client -c blue,green \"PORT=3001 tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b tsconfig.server.json && vite build",
    "clean": "rm -rf dist *.tsbuildinfo node_modules/.tmp",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc -b tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zod-crawler/core": "^1.0.0",
    "express": "^5",
    "prettier": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/figulusproject/zod-crawler",
    "directory": "apps/web"
  },
  "author": "The Figulus Project",
  "license": "MIT"
}
