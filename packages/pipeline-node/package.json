{
  "name": "@zod-crawler/pipeline-node",
  "version": "1.1.0",
  "description": "Node/Redis-backed fetch-and-cache backends for zod-crawler's schema-inference pipeline.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "dependencies": {
    "@zod-crawler/core": "^1.1.0",
    "@zod-crawler/pipeline": "^1.1.0"
  },
  "peerDependencies": {
    "bullmq": "^6.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "bullmq": "^6.0.0",
    "ioredis": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/figulusproject/zod-crawler",
    "directory": "packages/pipeline-node"
  },
  "author": "The Figulus Project",
  "license": "MIT"
}
