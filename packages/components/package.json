{
  "name": "@zod-crawler/components",
  "version": "1.1.0",
  "description": "Shared shadcn/Tailwind UI components for zod-crawler's web frontends.",
  "type": "module",
  "exports": {
    "./general": {
      "types": "./dist/components/general/index.d.ts",
      "import": "./dist/components/general/index.js"
    },
    "./crawl": {
      "types": "./dist/components/crawl/index.d.ts",
      "import": "./dist/components/crawl/index.js"
    },
    "./globals.css": "./src/styles/globals.css"
  },
  "imports": {
    "#lib/*": "./dist/lib/*.js",
    "#components/*": "./dist/components/*.js"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@zod-crawler/core": "^1.1.0",
    "@zod-crawler/pipeline": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/figulusproject/zod-crawler",
    "directory": "packages/components"
  },
  "author": "The Figulus Project",
  "license": "MIT"
}
